import tkinter as tk
from tkinter import messagebox
import random
import time
from dataclasses import dataclass

# =========================================================
# OPTIONAL RPI SUPPORT
# =========================================================

try:
    import board
    import digitalio
    from adafruit_matrixkeypad import Matrix_Keypad
    RPI_ENABLED = True
except ImportError:
    RPI_ENABLED = False


# =========================================================
# CONFIG
# =========================================================

WINDOW_BG = "#050505"
TEXT_GREEN = "#00FF66"
TEXT_RED = "#FF3333"
TEXT_YELLOW = "#FFD633"
TEXT_CYAN = "#00FFFF"

FONT_MAIN = ("Courier New", 18)
FONT_LARGE = ("Courier New", 28, "bold")

COUNTDOWN_SECONDS = 600
TOTAL_STRIKES = 5

# Toggle puzzle (FIXED LOGIC: using pull-up -> inverted)
TOGGLE_TARGET = [True, False, True, True]

FINAL_CODE = "5426"

WORD_BANK = ["array", "stack", "queue", "input", "debug"]

ANAGRAM_WORDS = ["python", "planet", "school", "science", "binary"]


# =========================================================
# GAME STATE
# =========================================================

@dataclass
class GameState:
    strikes: int = TOTAL_STRIKES
    timer: int = COUNTDOWN_SECONDS
    active: bool = False
    stage: str = "BOOT"

    anagram_wins: int = 0

    wordle_attempts: int = 0
    wordle_secret: str = ""

    keypad_input: str = ""

    last_keypress: float = 0


# =========================================================
# MAIN GAME
# =========================================================

class BombGame:

    def __init__(self, root):
        self.root = root
        self.state = GameState()

        self.root.title("Riddler's Revenge")
        self.root.configure(bg=WINDOW_BG)
        self.root.attributes("-fullscreen", True)

        self.setup_ui()
        self.setup_hardware()

        self.show_intro()
        self.root.after(100, self.hardware_loop)

    # =====================================================
    # UI
    # =====================================================

    def setup_ui(self):

        self.top = tk.Frame(self.root, bg=WINDOW_BG)
        self.top.pack(fill="x")

        self.timer_label = tk.Label(
            self.top, text="10:00",
            font=FONT_LARGE,
            fg=TEXT_RED, bg=WINDOW_BG
        )
        self.timer_label.pack(side="left", padx=10)

        self.strike_label = tk.Label(
            self.top,
            text=f"STRIKES: {self.state.strikes}",
            font=FONT_LARGE,
            fg=TEXT_YELLOW,
            bg=WINDOW_BG
        )
        self.strike_label.pack(side="right", padx=10)

        self.stage_label = tk.Label(
            self.top,
            text=self.state.stage,
            font=("Courier New", 16),
            fg=TEXT_CYAN,
            bg=WINDOW_BG
        )
        self.stage_label.pack(side="left", padx=10)

        self.content = tk.Frame(self.root, bg=WINDOW_BG)
        self.content.pack(expand=True)

    # =====================================================
    # HARDWARE
    # =====================================================

    def setup_hardware(self):

        if not RPI_ENABLED:
            return

        # FIXED: pull-up logic for stable switches
        self.toggles = [
            digitalio.DigitalInOut(pin)
            for pin in (board.D12, board.D16, board.D20, board.D21)
        ]

        for t in self.toggles:
            t.direction = digitalio.Direction.INPUT
            t.pull = digitalio.Pull.UP

        self.wires = [
            digitalio.DigitalInOut(pin)
            for pin in (board.D14, board.D15, board.D18, board.D23, board.D24)
        ]

        for w in self.wires:
            w.direction = digitalio.Direction.INPUT
            w.pull = digitalio.Pull.UP

        self.start_btn = digitalio.DigitalInOut(board.D4)
        self.start_btn.direction = digitalio.Direction.INPUT
        self.start_btn.pull = digitalio.Pull.DOWN

        self.previous_keys = []

    # =====================================================
    # LOOP
    # =====================================================

    def hardware_loop(self):

        self.stage_label.config(text=self.state.stage)

        if RPI_ENABLED:

            if self.state.stage == "BOOT":
                if self.start_btn.value:
                    self.activate()

            if self.state.stage == "TOGGLES":
                toggle_values = [not t.value for t in self.toggles]

                if toggle_values == TOGGLE_TARGET:
                    self.show_anagram()

            if self.state.stage == "FINAL":
                red = not self.wires[0].value
                blue = not self.wires[2].value

                if red and blue:
                    self.handle_keypad()

        self.root.after(100, self.hardware_loop)

    # =====================================================
    # TIMER
    # =====================================================

    def start_timer(self):

        if not self.state.active:
            return

        if self.state.timer <= 0:
            self.explode("TIME OUT")
            return

        self.state.timer -= 1

        m = self.state.timer // 60
        s = self.state.timer % 60

        self.timer_label.config(text=f"{m:02}:{s:02}")

        self.root.after(1000, self.start_timer)

    # =====================================================
    # UTIL
    # =====================================================

    def clear(self):
        for w in self.content.winfo_children():
            w.destroy()

    def update_strikes(self):
        self.strike_label.config(text=f"STRIKES: {self.state.strikes}")

    def strike(self, reason):
        self.state.strikes -= 1
        self.update_strikes()

        if self.state.strikes <= 0:
            self.explode(reason)
            return

        messagebox.showwarning("STRIKE", reason)

    def explode(self, reason):
        messagebox.showerror("BOOM", reason)
        self.root.destroy()

    def win(self):
        messagebox.showinfo("DEFUSED", "BOMB DEFUSED")
        self.root.destroy()

    # =====================================================
    # INTRO
    # =====================================================

    def show_intro(self):

        self.clear()

        tk.Label(
            self.content,
            text="RIDDLER'S REVENGE\nPRESS BUTTON TO START",
            fg=TEXT_GREEN,
            bg=WINDOW_BG,
            font=FONT_MAIN
        ).pack(expand=True)

    # =====================================================
    # START
    # =====================================================

    def activate(self):

        self.state.active = True
        self.state.stage = "TOGGLES"

        self.start_timer()
        self.clear()

        tk.Label(
            self.content,
            text="FLIP SWITCHES",
            fg=TEXT_RED,
            bg=WINDOW_BG,
            font=FONT_LARGE
        ).pack(expand=True)

    # =====================================================
    # ANAGRAM
    # =====================================================

    def show_anagram(self):

        self.state.stage = "ANAGRAM"
        self.clear()

        word = random.choice(ANAGRAM_WORDS)
        self.anagram = word
        scrambled = "".join(random.sample(word, len(word)))

        tk.Label(self.content, text=scrambled,
                 fg="white", bg=WINDOW_BG,
                 font=FONT_LARGE).pack()

        self.entry = tk.Entry(self.content, font=FONT_MAIN)
        self.entry.pack()

        tk.Button(self.content, text="SUBMIT",
                  command=self.check_anagram).pack()

    def check_anagram(self):

        if self.entry.get().lower() == self.anagram:
            self.state.anagram_wins += 1

            if self.state.anagram_wins >= 2:
                messagebox.showinfo("RIDDLE", "Digit: 5")
                self.show_ttt()
            else:
                self.show_anagram()
        else:
            self.strike("Wrong anagram")

    # =====================================================
    # TTT
    # =====================================================

    def show_ttt(self):

        self.state.stage = "TTT"
        self.clear()

        self.board = [""] * 9

        self.buttons = []

        frame = tk.Frame(self.content, bg=WINDOW_BG)
        frame.pack()

        for i in range(9):
            b = tk.Button(frame, text="", width=5, height=2,
                          command=lambda i=i: self.move(i))
            b.grid(row=i // 3, column=i % 3)
            self.buttons.append(b)

    def move(self, i):

        if self.board[i]:
            return

        self.board[i] = "X"
        self.buttons[i].config(text="X")

        if self.check_win("X"):
            messagebox.showinfo("RIDDLE", "Digit: 4")
            self.show_wordle()
            return

        self.ai()

    def ai(self):

        empty = [i for i in range(9) if self.board[i] == ""]
        if not empty:
            return

        i = random.choice(empty)
        self.board[i] = "O"
        self.buttons[i].config(text="O")

        if self.check_win("O"):
            self.strike("Lost TTT")
            self.show_ttt()

    def check_win(self, p):

        w = [(0,1,2),(3,4,5),(6,7,8),
             (0,3,6),(1,4,7),(2,5,8),
             (0,4,8),(2,4,6)]

        return any(
            self.board[a]==self.board[b]==self.board[c]==p
            for a,b,c in w
        )

    # =====================================================
    # WORDLE
    # =====================================================

    def show_wordle(self):

        self.state.stage = "WORDLE"
        self.clear()

        self.secret = random.choice(WORD_BANK)
        self.attempts = 0

        self.label = tk.Label(self.content, text="WORDLE")
        self.label.pack()

        self.e = tk.Entry(self.content)
        self.e.pack()

        tk.Button(self.content, text="GUESS",
                  command=self.guess_wordle).pack()

    def guess_wordle(self):

        g = self.e.get().lower()

        self.attempts += 1

        if g == self.secret:
            messagebox.showinfo("RIDDLE", "Digit: 2")
            self.final()
            return

        if self.attempts >= 5:
            self.strike("Wordle failed")
            self.show_wordle()

    # =====================================================
    # FINAL
    # =====================================================

    def final(self):

        self.state.stage = "FINAL"
        self.clear()

        self.input = ""

        self.display = tk.Label(self.content, text="")
        self.display.pack()

    def handle_keypad(self):

        # simulated fallback if no hardware
        pass

    # =====================================================
    # END
    # =====================================================

    def quit(self, e=None):
        self.root.destroy()


# =========================================================
# RUN
# =========================================================

root = tk.Tk()
game = BombGame(root)
root.bind("<Escape>", game.quit)
root.mainloop()